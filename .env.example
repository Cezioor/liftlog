# Copy to .env for local development. Never commit .env.
DEBUG=1

# --- Only needed when DEBUG=0 (production). On Render these are set in the dashboard. ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Extra hosts/origins besides the automatic *.onrender.com one, e.g. a custom domain:
# DJANGO_ALLOWED_HOSTS=liftlog.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://liftlog.example.com
# HSTS duration in seconds (default 3600). Raise once HTTPS works: 2592000 = 30 days.
# DJANGO_HSTS_SECONDS=3600

# Leave empty to use SQLite locally. Neon: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Email. Without BREVO_API_KEY emails (sign-up links, password reset) are printed to
# the console, which is what you want locally. On Render: the key from Brevo
# (SMTP & API > API keys) and a sender verified in Brevo.
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=LiftLog <you@example.com>

# Stage 2
ANTHROPIC_API_KEY=
