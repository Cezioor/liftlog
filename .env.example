# Copy to .env for local development. Never commit .env.
DEBUG=1
# Required when DEBUG=0. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Comma-separated, only used when DEBUG=0, e.g. liftlog.example.com
DJANGO_ALLOWED_HOSTS=
# Leave empty to use SQLite locally. Production: postgres://user:pass@host:5432/liftlog
DATABASE_URL=
# Stage 2
ANTHROPIC_API_KEY=
