msgid "beep when the rest is over"
msgstr "sygnał dźwiękowy na koniec przerwy"

#: .\accounts\models.py:48
msgid "Only while LiftLog is on screen; a locked phone can't play it."
msgstr "Tylko gdy LiftLog jest na ekranie; zablokowany telefon go nie odtworzy."

