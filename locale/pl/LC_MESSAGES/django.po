msgid "Simple: Easy / Medium / Hard / Max effort"
msgstr "Prosta: Lekko / Średnio / Ciężko / Maksimum"

#: .\accounts\models.py:19
msgid "RIR: reps left in the tank (0, 1, 2, 3, 4+)"
msgstr "RIR: ile powtórzeń zostało w zapasie (0, 1, 2, 3, 4+)"

