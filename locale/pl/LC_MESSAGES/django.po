#: .\accounts\adapter.py:12
msgid "Account created. We also sent a link to confirm your email address."
msgstr "Konto założone. Wysłaliśmy też link do potwierdzenia adresu e-mail."

#: .\accounts\adapter.py:14
msgid ""
"Account created, but we couldn't send the link to confirm your email address. You can ask for a "
"new one in your account settings."
msgstr ""
"Konto założone, ale nie udało się wysłać linku do potwierdzenia adresu e-mail. Możesz poprosić o "
"nowy w ustawieniach konta."

